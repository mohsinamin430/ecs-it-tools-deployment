# IT-Tools dependencies, build output, and test reports
/app/node_modules/
/app/dist/
/app/coverage/
/app/test-results/
/app/playwright-report/
/app/playwright/.cache/
/app/salt
/app/*.tsbuildinfo
/app/*.log

# Local environment files; keep example configuration
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Terraform provider caches and local state
.terraform/
*.tfstate
*.tfstate.*

# Local Terraform variables and plans created by the workflows
*.tfvars.json
tfplan
tfdestroy

# Keep app/pnpm-lock.yaml and Terraform .terraform.lock.hcl files tracked.
